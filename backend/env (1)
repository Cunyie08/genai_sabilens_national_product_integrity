# =============================================================================
# SabiLens Backend — Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in every value marked with <REPLACE>.
# Lines starting with # are comments and are ignored.
# =============================================================================


# -----------------------------------------------------------------------------
# APP
# -----------------------------------------------------------------------------
APP_NAME=SabiLens
APP_VERSION=1.0.0
# DEBUG accepts: true/false  or  dev/production
DEBUG=false


# -----------------------------------------------------------------------------
# GCP CLOUD SQL — DATABASE
# -----------------------------------------------------------------------------
# Format: postgresql+asyncpg://postgres:<PASSWORD>@<CLOUD_SQL_PUBLIC_IP>:5433/sabilens
# Retrieve public IP: gcloud sql instances describe sabilens-db --format="value(ipAddresses[0].ipAddress)"
DATABASE_URL="postgresql+asyncpg://postgres:Chicken_noodles70g@127.0.0.1:5433/sabilens?ssl=disable"
# DATABASE_URL="postgresql+asyncpg://postgres:YourActualCloudPasswordHere@localhost:5433/sabilens?ssl=disable"

# -----------------------------------------------------------------------------
# REDIS  (used for Celery task queue and caching)
# -----------------------------------------------------------------------------
# Local Redis:
REDIS_URL=redis://redis-19402.c266.us-east-1-3.ec2.cloud.redislabs.com:19402
# Upstash (serverless Redis, compatible with Supabase stack):
# REDIS_URL=rediss://:<REPLACE_UPSTASH_PASSWORD>@<REPLACE_UPSTASH_HOST>:6380

CELERY_BROKER_URL=redis://localhost:6379
CELERY_RESULT_BACKEND=redis://localhost:6379


# -----------------------------------------------------------------------------
# JWT / AUTHENTICATION
# -----------------------------------------------------------------------------
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=b870f96c-b21a-4ef3-a4e4-18aac11ebe4f
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
# Set to True to skip email/phone verification during registration (dev only)
AUTH_AUTO_ACTIVATE=true


# -----------------------------------------------------------------------------
# GCP — PROJECT & CREDENTIALS
# -----------------------------------------------------------------------------
GCP_PROJECT_ID=project-b7d671ed-83b2-411b-a3d
# Path to service account key JSON. Omit on GCE/GKE/Cloud Run (Workload Identity used automatically).
GOOGLE_APPLICATION_CREDENTIALS=/path/to/sabilens-backend-key.json


# -----------------------------------------------------------------------------
# FILE STORAGE — Google Cloud Storage
# -----------------------------------------------------------------------------
# Scan images + product artwork (public-read bucket)
GCS_BUCKET=sabilens-scan-images-prod
# AI PDF reports (private bucket, signed URLs)
GCS_REPORTS_BUCKET=sabilens-reports-prod
# ML/OCR model files
GCS_MODELS_BUCKET=sabilens-models-prod


# -----------------------------------------------------------------------------
# AI / ML SERVICE ENDPOINTS
# -----------------------------------------------------------------------------
# Internal microservice URLs — update if deployed separately
AI_VISUAL_ENDPOINT=http://localhost:8001/visual
AI_OCR_ENDPOINT=http://localhost:8002/ocr
AI_REGULATORY_ENDPOINT=http://localhost:8003/regulatory
AI_FUSION_ENDPOINT=http://localhost:8004/fusion

# RAG (Retrieval-Augmented Generation) service
RAG_SERVICE_URL=http://127.0.0.1:8001
RAG_SERVICE_TIMEOUT_SECONDS=20.0
